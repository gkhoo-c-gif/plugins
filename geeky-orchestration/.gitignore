# Python bytecode
__pycache__/
*.py[cod]

# uv / virtualenv artifacts from running the bundled MCP server locally.
# The server runs via `uv run --with "mcp>=1.2.0"` (ephemeral env), so these are not shipped.
mcp/.venv/
mcp/uv.lock
.venv/
*/.plugin-eval/**/*
# Node mirror dev tooling (runtime is dependency-free; see package.json).
node_modules/
